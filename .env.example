# Copy this file to .env and fill in real values. Every setting has a safe
# default, so the app runs (AI features disabled) even without a .env file.

# Get a key at https://console.anthropic.com/ - required for all AI features.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# SEC EDGAR requires a descriptive User-Agent: "Your Name your.email@example.com"
SEC_USER_AGENT=MarketPulse Copilot your.email@example.com

# Tickers ingested automatically on first boot and shown as defaults.
MARKETPULSE_TICKERS=AAPL,MSFT,JPM,NVDA,GS
MARKETPULSE_AUTO_SEED=1

# Cost guardrails for the public demo (checked before every billed LLM call).
MARKETPULSE_MAX_CLIENT_LLM_CALLS=15
MARKETPULSE_MAX_DAILY_LLM_CALLS=150
MARKETPULSE_AGENT_MAX_STEPS=6

# Only needed if the frontend is hosted on a different origin than the API.
# MARKETPULSE_CORS_ORIGINS=http://localhost:5173

# Optional overrides.
# MARKETPULSE_DB_PATH=./data/marketpulse.db
# CHROMA_PERSIST_DIR=./data/chroma
