{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docs/**,eval/**,scripts/**,.github/**,frontend/node_modules/**,frontend/src/**,frontend/public/**,data/**,Dockerfile,render.yaml}"
    }
  }
}
